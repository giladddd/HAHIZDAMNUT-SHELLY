<style>
  .stripeCourses .courseCardNew.videoCard { display:grid !important; grid-template-rows:50% 50% !important; aspect-ratio:1 / 1.1 !important; overflow:hidden; height:auto; }
  .stripeCourses .courseCardNew.videoCard.noText { grid-template-rows:100% !important; }
  .stripeCourses .courseCardNew.videoCard > .image { aspect-ratio:auto !important; position:relative; height:100%; width:100%; overflow:hidden; min-height:0; }
  .stripeCourses .courseCardNew.videoCard > .text { min-height:0; overflow:hidden; }
  .stripeCourses .courseCardNew.videoCard { text-decoration:none; color:inherit; }
  .stripeCourses .courseCardNew.videoCard .videoEmbed { position:absolute; inset:0; overflow:hidden; background:#000; }
  .stripeCourses .courseCardNew.videoCard .videoEmbed img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .stripeCourses .courseCardNew.videoCard .videoEmbed .playBtn { position:absolute; top:50%; left:50%; width:56px; height:56px; transform:translate(-50%,-50%); border-radius:50%; background:rgba(0,0,0,.55); display:flex; align-items:center; justify-content:center; transition:background .15s; z-index:2; }
  .stripeCourses .courseCardNew.videoCard .videoEmbed a:hover .playBtn { background:rgba(0,0,0,.8); }
  .stripeCourses .courseCardNew.videoCard .videoEmbed .playBtn::before { content:""; display:block; width:0; height:0; border-style:solid; border-width:10px 0 10px 16px; border-color:transparent transparent transparent #fff; margin-left:3px; }
  .stripeCourses .courseCardNew.videoCard .text { padding:20px 16px; overflow:hidden; min-width:0; }
  .stripeCourses .courseCardNew.videoCard .text .content { width:100%; }
  .stripeCourses .courseCardNew.videoCard .text .content h3 { font-size:18px; line-height:22px; color:#000; margin:0 0 6px 0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; overflow-wrap:anywhere; word-break:break-word; }
  .stripeCourses .courseCardNew.videoCard .text .content p { font-size:14px; line-height:20px; margin:0; color:#323333; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; overflow-wrap:anywhere; word-break:break-word; }
  /* Hide slick arrows when no scroll is available in that direction (videos stripe) */
  [id^="videosCarusel"] .slick-arrow.slick-disabled { opacity:0 !important; pointer-events:none !important; visibility:hidden !important; }
</style>

